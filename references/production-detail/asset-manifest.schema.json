{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/blender-ai-previs/asset-manifest.schema.json",
  "title": "TYGG AI Film Studio Asset Manifest",
  "type": "object",
  "required": ["schema_version", "id", "version", "source", "license", "units", "root_collection", "lods"],
  "properties": {
    "schema_version": {
      "enum": ["1.1", "1.2"],
      "description": "Version 1.2 adds optional location, content, promotion, and validation records. Version 1.1 manifests remain valid."
    },
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "category": {"type": "string"},
    "asset_kind": {
      "type": "string",
      "description": "Recommended values include location_set, prop, character, animation, material, or environment_module. Location sets are the default reusable unit for complete places."
    },
    "reuse_scope": {
      "enum": ["project_only", "shared_library", "draft"],
      "description": "Where this asset may be reused. Shared publication still requires license and dependency review."
    },
    "source": {
      "type": "object",
      "required": ["url", "asset_path"],
      "properties": {
        "url": {"type": ["string", "null"], "description": "Original asset page; null for an internally authored asset without a public URL."},
        "asset_path": {"type": "string", "minLength": 1, "description": "Path relative to the asset library root."},
        "downloaded_at": {"type": ["string", "null"], "format": "date-time"},
        "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      }
    },
    "license": {
      "type": "object",
      "required": ["name", "status", "url"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["verified", "unverified"]},
        "url": {"type": ["string", "null"]},
        "license_file": {"type": ["string", "null"], "description": "Saved license text relative to the asset library root."},
        "attribution": {"type": ["string", "null"]},
        "redistribution": {"enum": ["allowed", "restricted", "unknown"]},
        "notes": {"type": "string"}
      }
    },
    "units": {"const": "m"},
    "root_collection": {"type": "string", "minLength": 1},
    "forward_axis": {"enum": ["X", "-X", "Y", "-Y", "Z", "-Z"]},
    "up_axis": {"const": "Z"},
    "lods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "collection", "triangles"],
        "properties": {
          "level": {"type": "integer", "minimum": 0},
          "collection": {"type": "string", "minLength": 1},
          "triangles": {"type": "integer", "minimum": 0},
          "material_slots": {"type": "integer", "minimum": 0},
          "texture_max_px": {"type": "integer", "minimum": 0},
          "texture_mb": {"type": "number", "minimum": 0},
          "screen_size_min_px": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "rig": {
      "type": ["object", "null"],
      "properties": {
        "armature_object": {"type": "string"},
        "skeleton_id": {"type": "string"},
        "rest_pose": {"type": "string"},
        "root_motion_bone": {"type": ["string", "null"]},
        "retarget_profile": {"type": ["string", "null"]}
      }
    },
    "animations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action", "frame_range", "fps", "loop", "root_motion"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "frame_range": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
          "fps": {"type": "number", "exclusiveMinimum": 0},
          "loop": {"type": "boolean"},
          "root_motion": {"enum": ["in_place", "root_bone", "object", "unknown"]},
          "contact_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["frame", "effector", "type"],
              "properties": {
                "frame": {"type": "integer"},
                "effector": {"type": "string"},
                "type": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "location_contract": {
      "type": ["object", "null"],
      "description": "Optional spatial contract for a complete reusable location; it describes fixed space and interfaces, never a scene's performance.",
      "properties": {
        "spatial_topology": {"type": ["string", "null"], "description": "Relative path or concise identifier for the documented layout/topology."},
        "functional_zones": {"type": "array", "items": {"type": "string"}},
        "portals": {"type": "array", "items": {"type": "string"}},
        "staging_anchors": {"type": "array", "items": {"type": "string"}},
        "collision_collection": {"type": ["string", "null"]},
        "nav_areas": {"type": "array", "items": {"type": "string"}},
        "bounds": {
          "type": ["object", "null"],
          "properties": {
            "min": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
            "max": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3}
          }
        }
      }
    },
    "content_contract": {
      "type": ["object", "null"],
      "description": "Optional declaration of data removed from a reusable location package. Blender inspection, not this declaration alone, proves the package is clean.",
      "properties": {
        "contains_cameras": {"type": "boolean"},
        "contains_timeline_markers": {"type": "boolean"},
        "contains_character_objects": {"type": "boolean"},
        "contains_character_paths": {"type": "boolean"},
        "contains_animation_data": {"type": "boolean"},
        "contains_storyboard_data": {"type": "boolean"},
        "contains_scene_lighting": {"type": "boolean"},
        "contains_prompt_data": {"type": "boolean"},
        "contains_tempo_data": {"type": "boolean"},
        "contains_absolute_project_paths": {"type": "boolean"}
      }
    },
    "promotion": {
      "type": ["object", "null"],
      "description": "Optional record of the user-selected asset promotion decision after static scene review.",
      "properties": {
        "status": {"enum": ["draft", "project_only", "shared_library", "rejected"]},
        "promoted_from_revision": {"type": ["string", "null"]},
        "user_selected_scope": {"enum": ["project_only", "shared_library", "draft"]},
        "parent_asset_id": {"type": ["string", "null"], "description": "Set for a persistent variant or derivative; do not overwrite the parent asset."},
        "parent_asset_version": {"type": ["string", "null"]},
        "variant_kind": {"enum": ["none", "project_local_variant", "new_version", "derived_location"]}
      }
    },
    "validation": {
      "type": ["object", "null"],
      "description": "Optional independent test-load and contamination-scan evidence.",
      "properties": {
        "static_scene_review": {"enum": ["passed", "failed", "unverified"]},
        "independent_test_load": {"enum": ["passed", "failed", "unverified"]},
        "contamination_scan": {"enum": ["passed", "failed", "unverified"]},
        "checked_at": {"type": ["string", "null"], "format": "date-time"},
        "report_path": {"type": ["string", "null"], "description": "Path relative to the asset library root."},
        "notes": {"type": "string"}
      }
    },
    "tags": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
